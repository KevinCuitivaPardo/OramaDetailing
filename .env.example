# ───────────────────────────────────────────────────────────────
#  Orama’s Detailing — variables de entorno
#  Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` a git.
#  Todo lo marcado PENDIENTE lo debe aportar el dueño; el sistema no inventa datos.
# ───────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Base de datos SQLite (en producción usa un disco persistente y haz copias de seguridad)
DATABASE_PATH=./data/orama.db

# Detrás de un proxy (Nginx, Render, Fly, Railway…) pon 1 para que el límite de solicitudes use la IP real
TRUST_PROXY=0

# URL pública del sitio (se usa en los enlaces de los correos). En producción: https://tu-dominio.com
PUBLIC_BASE_URL=http://localhost:5173
# Orígenes extra permitidos por CORS, separados por coma. Vacío = solo mismo origen.
CORS_ORIGINS=

# Clave para cifrar teléfono, correo y lugar en la base de datos. OBLIGATORIA en producción.
# Genera una con:  npm run gen:key     (guárdala en un gestor de secretos: si se pierde, no se pueden leer los datos)
DATA_ENCRYPTION_KEY=

# ── Gmail (PENDIENTE: lo aporta el dueño) ──────────────────────
# Opción A (recomendada): contraseña de aplicación. Requiere verificación en 2 pasos en la cuenta de Google.
#   https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Orama’s Detailing
# Opción B: OAuth2 (si no quieres usar contraseña de aplicación)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# ── Correo del propietario: recibe el resumen diario y los avisos de cambios/cancelaciones.
# Ya está definido por el dueño; se deja aquí solo para poder cambiarlo sin tocar código.
OWNER_EMAIL=oramasdetailing@gmail.com

# ── Contacto de la empresa (datos que ya entregó el dueño; el WhatsApp sale de aquí) ─────
WHATSAPP_NUMBER=17876625851
BUSINESS_PHONE=787-662-5851
BUSINESS_INSTAGRAM=@oramaautodetailing

# ── Políticas de reservas ──────────────────────────────────────
# Minutos antes de la cita hasta los que el cliente puede cambiar o cancelar por su cuenta
CHANGE_CUTOFF_MINUTES=60
# Máximo de reservas futuras activas por teléfono y por correo
MAX_ACTIVE_PER_PHONE=3
MAX_ACTIVE_PER_EMAIL=3

# ── Acceso del administrador (panel /admin.html y /api/admin). Sin secreto queda deshabilitado (404).
# Genera uno de 256 bits:  npm run gen:admin-token   (se imprime una vez; pégalo AQUÍ o en el gestor de secretos del hosting)
# NUNCA lo subas al repositorio ni lo pongas en el frontend.
ADMIN_TOKEN_SECRET=
# Solo durante una rotación: el secreto anterior sigue valiendo hasta que lo quites
ADMIN_TOKEN_SECRET_PREVIOUS=

# ── Disparador externo de tareas (opcional, recomendado en producción como red de seguridad).
# Un cron externo (GitHub Actions, cron-job.org) llama POST /api/internal/tareas/{resumen|limpieza|correos|respaldo}
# con "Authorization: Bearer <este secreto>". Genera uno con npm run gen:admin-token. Sin valor, la ruta no existe (404).
JOBS_TRIGGER_SECRET=

# ── Tareas programadas (hora del negocio: America/Puerto_Rico) ──────
JOBS_ENABLED=true
OWNER_SUMMARY_CRON=0 23 * * *
# Limpieza semanal: domingos 11:59 p. m. (la semana de lunes a domingo ya terminó)
CLEANUP_CRON=59 23 * * 0
# Tope de reservas que la limpieza AUTOMÁTICA puede borrar de una vez (si propone más, se aborta y avisa)
CLEANUP_MAX_DELETE=500
BACKUP_CRON=0 2 * * *
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=14
OUTBOX_INTERVAL_SECONDS=30

# ── Solo para pruebas de carga en un entorno que NO sea producción (en producción el servidor se niega a arrancar con false)
# RATE_LIMITS_ENABLED=false
