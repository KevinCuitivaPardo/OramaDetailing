{
  "name": "oramas-detailing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio y reservas de Orama’s Detailing, Aguada, P.R.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --no-warnings --test --test-concurrency=1 \"tests/*.test.js\"",
    "gen:key": "node scripts/gen-key.mjs",
    "lint:security": "eslint server shared scripts src",
    "audit:deps": "npm audit --omit=dev",
    "gen:admin-token": "node scripts/gen-admin-token.mjs",
    "admin:password": "node --env-file-if-exists=.env scripts/admin-password.mjs",
    "job:summary": "node --env-file-if-exists=.env scripts/run-job.mjs summary",
    "job:cleanup": "node --env-file-if-exists=.env scripts/run-job.mjs cleanup",
    "job:outbox": "node --env-file-if-exists=.env scripts/run-job.mjs outbox",
    "job:requeue": "node --env-file-if-exists=.env scripts/run-job.mjs requeue",
    "backup": "node --env-file-if-exists=.env scripts/run-job.mjs backup"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vite-plugin-handlebars": "^2.0.3"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
